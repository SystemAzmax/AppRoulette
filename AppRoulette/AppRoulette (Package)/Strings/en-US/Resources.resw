<?xml version="1.0" encoding="utf-8"?>
<!--
  Package.appxmanifest から ms-resource: で参照する、英語の表示名と説明。
  パッケージの既定の言語（wapproj の DefaultLanguage）が en-US のため、
  日本語以外のすべての言語でこのファイルが使われる。
  表示名は Partner Center で予約した名前にする（docs/BuildGuide.md を参照）。
-->
<root>
  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <resheader name="reader">
    <value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <resheader name="writer">
    <value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <data name="AppDisplayName" xml:space="preserve">
    <value>AppRoulette</value>
    <comment>App name shown in the Start menu and elsewhere</comment>
  </data>
  <data name="AppDescription" xml:space="preserve">
    <value>An app that spins a roulette wheel to pick one of the items you register</value>
    <comment>App description</comment>
  </data>
</root>
