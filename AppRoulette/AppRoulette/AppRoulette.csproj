<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AppRoulette</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Copilot_20260614_202528.ico</ApplicationIcon>
    <!-- exe 版の「このアプリについて」に表示するバージョン。
         ストア版は Package.appxmanifest の Identity の Version を表示するため、
         リリースのときは両方を同じ値にする（docs/BuildGuide.md を参照） -->
    <Version>1.0.0</Version>
    <Copyright>© 2026 SystemAzmax</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <!-- 「ライセンス情報」で開く、使用しているソフトウェアのライセンス表示。
         パッケージを更新したときの作り直し方は docs/BuildGuide.md を参照 -->
    <Content Include="ThirdPartyNotices.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- exe のアイコンと同じものを、ウィンドウとタスクバーのアイコンにも使う（App.xaml.cs で読み込む） -->
    <Content Include="Copilot_20260614_202528.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <!-- Windows App SDK は、使う部品のパッケージだけを参照する（使わない Windows ML や AI の DLL を配布物に含めないため）。
         WinUI の部品が Base / Foundation / InteractiveExperiences を引き込む。
         Runtime は、ストア版をフレームワーク パッケージ（Microsoft.WindowsAppRuntime.2）に依存させるために参照する。
         更新するときは、2 つを同じバージョンにする（パッケージ用の wapproj も同じ） -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.6.4" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AppRoulette.Core\AppRoulette.Core.csproj" />
  </ItemGroup>

    <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
    <ApplicationIcon>Copilot_20260614_202528.ico</ApplicationIcon>
  </PropertyGroup>
</Project>