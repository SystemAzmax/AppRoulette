<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AppRoulette.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AppRoulette"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AppRoulette">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

        <!--
        ルート Grid: 左列（ルーレット）/ 区切り / 右列（入力パネル）
    -->
    <Grid Margin="16" Loaded="OnRootGridLoaded">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!-- ===== 左列：ルーレット描画エリア ===== -->
        <Grid Grid.Column="0">

            <!-- Win2D CanvasControl（扇形描画・インジケーター含む） -->
            <canvas:CanvasControl
                x:Name="RouletteCanvas"
                Draw="RouletteCanvas_Draw"
                Tapped="RouletteCanvas_Tapped"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />

        </Grid>

        <!-- ===== 右列：入力パネル ===== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- グループ ComboBox + アイテム数表示 + 保存状態 -->
            <Grid
                Grid.Row="0"
                VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">

                    <ComboBox
                        x:Name="GroupComboBox"
                        ItemsSource="{x:Bind ViewModel.GroupList, Mode=OneWay}"
                        DisplayMemberPath="DisplayName"
                        SelectionChanged="GroupComboBox_SelectionChanged"
                        MinWidth="160" />

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="2"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="リスト"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="{x:Bind ViewModel.SelectedGroupPositionText, Mode=OneWay}"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- アイテム数：「n 件」 -->
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="2"
                                    VerticalAlignment="Center">
                            <TextBlock
                                Text="{x:Bind ViewModel.ItemCount, Mode=OneWay}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Text="件"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <Button
                            Content="クリア"
                            Command="{x:Bind ViewModel.ClearItemsCommand}"
                            Padding="8,4"
                            CornerRadius="4" />
                    </StackPanel>

                </StackPanel>

                <TextBlock
                    Grid.Row="1"
                    Text="{x:Bind ViewModel.SaveStatusText, Mode=OneWay}"
                    Margin="0,4,0,0"
                    TextWrapping="NoWrap"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Opacity="0.72" />

                <Grid
                    Grid.Row="2"
                    Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="GroupNameUnsavedBorder"
                        Grid.Column="0"
                        BorderBrush="Transparent"
                        BorderThickness="2"
                        CornerRadius="6"
                        Padding="2">
                        <TextBox
                            Text="{x:Bind ViewModel.GroupNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="グループ名" />
                    </Border>
                    <Button
                        Grid.Column="2"
                        Content="変更"
                        Command="{x:Bind ViewModel.RenameGroupCommand}"
                        Padding="8,4"
                        CornerRadius="4" />
                    <Button
                        Grid.Column="4"
                        Content="リセット"
                        Command="{x:Bind ViewModel.ResetGroupNameCommand}"
                        Padding="8,4"
                        CornerRadius="4" />
                </Grid>

                <TextBlock
                    x:Name="GroupNameUnsavedText"
                    Grid.Row="3"
                    Text="未保存"
                    Margin="0,4,0,0"
                    FontSize="12"
                    Foreground="DarkOrange"
                    Opacity="0" />

                <StackPanel
                    Grid.Row="4"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="0,8,0,0">
                    <Button
                        Content="追加"
                        Command="{x:Bind ViewModel.AddGroupCommand}"
                        Padding="8,4"
                        CornerRadius="4" />
                    <Button
                        Content="複製"
                        Command="{x:Bind ViewModel.DuplicateGroupCommand}"
                        Padding="8,4"
                        CornerRadius="4" />
                    <Button
                        Content="削除"
                        Command="{x:Bind ViewModel.DeleteGroupCommand}"
                        Padding="8,4"
                        CornerRadius="4" />
                    <Button
                        Content="上へ"
                        Command="{x:Bind ViewModel.MoveGroupUpCommand}"
                        Padding="8,4"
                        CornerRadius="4" />
                    <Button
                        Content="下へ"
                        Command="{x:Bind ViewModel.MoveGroupDownCommand}"
                        Padding="8,4"
                        CornerRadius="4" />
                </StackPanel>

            </Grid>

            <!-- アイテム表形式編集エリア -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="120" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Spacing="4"
                    Margin="0,0,0,8">
                    <TextBlock
                        Text="選択アイテム操作"
                        FontSize="12"
                        FontWeight="SemiBold" />
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            Content="アイテム追加"
                            Command="{x:Bind ViewModel.AddItemRowCommand}"
                            Padding="8,4"
                            CornerRadius="4" />
                        <Button
                            Content="選択削除"
                            Command="{x:Bind ViewModel.DeleteSelectedItemRowCommand}"
                            Padding="8,4"
                            CornerRadius="4" />
                    </StackPanel>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            Content="選択を上へ"
                            Command="{x:Bind ViewModel.MoveItemRowUpCommand}"
                            Padding="8,4"
                            CornerRadius="4" />
                        <Button
                            Content="選択を下へ"
                            Command="{x:Bind ViewModel.MoveItemRowDownCommand}"
                            Padding="8,4"
                            CornerRadius="4" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="0,0,0,8">
                    <TextBlock
                        Text="一覧全体:"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold" />
                    <Button
                        Content="一覧ソート"
                        Command="{x:Bind ViewModel.SortItemsCommand}"
                        Padding="8,4"
                        CornerRadius="4" />
                    <Button
                        Content="一覧シャッフル"
                        Command="{x:Bind ViewModel.ShuffleItemsCommand}"
                        Padding="8,4"
                        CornerRadius="4" />
                    <TextBlock
                        Text="Weight は 1～5"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Opacity="0.72" />
                </StackPanel>

                <Border
                    Grid.Row="2"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid
                            Grid.Row="0"
                            Padding="8,6"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="#" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="名前" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="Weight" FontWeight="SemiBold" />
                        </Grid>

                        <ListView
                            x:Name="ItemsListView"
                            Grid.Row="1"
                            ItemsSource="{x:Bind ViewModel.EditableItems, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedEditableItem, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Text="•"
                                            VerticalAlignment="Center" />
                                        <TextBox
                                            Grid.Column="1"
                                            Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextChanged="OnEditableItemTextChanged"
                                            PlaceholderText="名前" />
                                        <NumberBox
                                            Grid.Column="3"
                                            Value="{Binding Weight, Mode=TwoWay}"
                                            Minimum="1"
                                            Maximum="5"
                                            MinWidth="112"
                                            SmallChange="1"
                                            SpinButtonPlacementMode="Compact"
                                            ValueChanged="OnEditableItemWeightChanged" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <TextBlock
                    Grid.Row="3"
                    Text="{x:Bind ViewModel.ItemEditStatusText, Mode=OneWay}"
                    Margin="0,6,0,6"
                    FontSize="12"
                    Foreground="DarkOrange"
                    TextWrapping="Wrap" />

                <TextBox
                    x:Name="ItemsTextBox"
                    Grid.Row="4"
                    TextChanged="OnItemsTextBoxTextChanged"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    FontFamily="Consolas"
                    PlaceholderText="テキスト貼り付けも可能です（名前,Weight / 最大30件）" />
            </Grid>

        </Grid>
    </Grid>
</Window>
