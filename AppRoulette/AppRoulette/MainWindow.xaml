<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AppRoulette.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AppRoulette"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AppRoulette">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

        <!--
        ルート Grid: 左列（ルーレット）/ 中央列（リスト項目タブ）/ 右列（操作パネル）
    -->
    <Grid Margin="16" Loaded="OnRootGridLoaded">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- ===== 左列：ルーレット描画エリア ===== -->
        <Grid Grid.Column="0">

            <!-- Win2D CanvasControl（扇形描画・インジケーター含む） -->
            <canvas:CanvasControl
                x:Name="RouletteCanvas"
                Draw="RouletteCanvas_Draw"
                Tapped="RouletteCanvas_Tapped"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />

        </Grid>

        <!-- ===== 中央列：リスト項目タブ（詳細 / テキスト） ===== -->
        <Grid
            Grid.Column="2"
            Margin="4,4,4,0"
            VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                TabView 標準のタブ下線は実際のタブ幅分しか描画されず、
                右側の空きエリアで線が途切れて見えるため、
                タブ行全体に明示的な Border（下線）を敷いて解消する。
            -->
            <Border
                Grid.Row="0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Spacing="0">
                    <Button
                        x:Name="DetailTabButton"
                        Content="詳細"
                        Click="OnDetailTabButtonClick"
                        Padding="16,8"
                        CornerRadius="0"
                        Background="Transparent"
                        BorderThickness="0" />
                    <Button
                        x:Name="TextTabButton"
                        Content="テキスト"
                        Click="OnTextTabButtonClick"
                        Padding="16,8"
                        CornerRadius="0"
                        Background="Transparent"
                        BorderThickness="0" />
                </StackPanel>
            </Border>

            <!-- 詳細タブの内容 -->
            <Grid
                x:Name="DetailTabPanel"
                Grid.Row="1"
                Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- アイテム詳細表 -->
                <Border
                    Grid.Row="0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid
                            Grid.Row="0"
                            Padding="8,6"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="#" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="名前" FontWeight="SemiBold" />
                            <TextBlock
                                Grid.Column="3"
                                Text="Weight"
                                FontWeight="SemiBold"
                                ToolTipService.ToolTip="Weight は 1～5 の範囲で指定します。値が大きいほど選ばれやすくなります。" />
                        </Grid>

                        <ListView
                            x:Name="ItemsListView"
                            Grid.Row="1"
                            ItemsSource="{x:Bind ViewModel.EditableItems, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedEditableItem, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Text="•"
                                            VerticalAlignment="Center" />
                                        <TextBox
                                            Grid.Column="1"
                                            Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextChanged="OnEditableItemTextChanged"
                                            PlaceholderText="名前" />
                                        <NumberBox
                                            Grid.Column="3"
                                            Value="{Binding Weight, Mode=TwoWay}"
                                            Minimum="1"
                                            Maximum="5"
                                            MinWidth="112"
                                            SmallChange="1"
                                            SpinButtonPlacementMode="Compact"
                                            ValueChanged="OnEditableItemWeightChanged"
                                            ToolTipService.ToolTip="Weight は 1～5 の範囲で指定します。値が大きいほど選ばれやすくなります。" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <TextBlock
                    Grid.Row="1"
                    Text="{x:Bind ViewModel.ItemEditStatusText, Mode=OneWay}"
                    Margin="0,6,0,0"
                    FontSize="12"
                    Foreground="DarkOrange"
                    TextWrapping="Wrap" />
            </Grid>

            <!-- テキストタブの内容 -->
            <Grid
                x:Name="TextTabPanel"
                Grid.Row="1"
                Margin="0,8,0,0"
                Visibility="Collapsed">
                <TextBox
                    x:Name="ItemsTextBox"
                    TextChanged="OnItemsTextBoxTextChanged"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    FontFamily="Consolas"
                    PlaceholderText="テキスト貼り付けも可能です（名前,Weight / 最大30件）" />
            </Grid>
        </Grid>


        <!-- ===== 右列：操作パネル ===== -->
        <ScrollViewer
            Grid.Column="4"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">

                <!-- グループ ComboBox + リスト位置 + アイテム数 + クリア -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">

                    <ComboBox
                        x:Name="GroupComboBox"
                        ItemsSource="{x:Bind ViewModel.GroupList, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedGroup, Mode=TwoWay}"
                        DisplayMemberPath="DisplayName"
                        SelectionChanged="GroupComboBox_SelectionChanged"
                        MinWidth="120" />

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="2"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="リスト"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="{x:Bind ViewModel.SelectedGroupPositionText, Mode=OneWay}"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- アイテム数：「n 件」 -->
                    <StackPanel Orientation="Horizontal" Spacing="2"
                                VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind ViewModel.ItemCount, Mode=OneWay}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="件"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <Button
                        Content="クリア"
                        Command="{x:Bind ViewModel.ClearItemsCommand}"
                        Padding="8,4"
                        CornerRadius="4" />
                </StackPanel>

                <TextBlock
                    Text="{x:Bind ViewModel.SaveStatusText, Mode=OneWay}"
                    TextWrapping="NoWrap"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Opacity="0.72" />

                <!-- グループ名編集 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="GroupNameUnsavedBorder"
                        Grid.Column="0"
                        BorderBrush="Transparent"
                        BorderThickness="2"
                        CornerRadius="6"
                        Padding="2">
                        <TextBox
                            Text="{x:Bind ViewModel.GroupNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="グループ名" />
                    </Border>
                    <Button
                        Grid.Column="2"
                        Content="変更"
                        Command="{x:Bind ViewModel.RenameGroupCommand}"
                        Padding="8,4"
                        CornerRadius="4" />
                    <Button
                        Grid.Column="4"
                        Content="リセット"
                        Command="{x:Bind ViewModel.ResetGroupNameCommand}"
                        Padding="8,4"
                        CornerRadius="4" />
                </Grid>

                <TextBlock
                    x:Name="GroupNameUnsavedText"
                    Text="未保存"
                    FontSize="12"
                    Foreground="DarkOrange"
                    Opacity="0" />

                <!-- グループ操作 -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Content="追加"
                        Command="{x:Bind ViewModel.AddGroupCommand}"
                        Padding="8,4"
                        CornerRadius="4" />
                    <Button
                        Content="複製"
                        Command="{x:Bind ViewModel.DuplicateGroupCommand}"
                        Padding="8,4"
                        CornerRadius="4" />
                    <Button
                        Content="削除"
                        Command="{x:Bind ViewModel.DeleteGroupCommand}"
                        Padding="8,4"
                        CornerRadius="4" />
                    <Button
                        Content="上へ"
                        Command="{x:Bind ViewModel.MoveGroupUpCommand}"
                        Padding="8,4"
                        CornerRadius="4" />
                    <Button
                        Content="下へ"
                        Command="{x:Bind ViewModel.MoveGroupDownCommand}"
                        Padding="8,4"
                        CornerRadius="4" />
                </StackPanel>

                <!-- 選択アイテム操作 -->
                <TextBlock
                    Text="選択アイテム操作"
                    Margin="0,8,0,0"
                    FontSize="12"
                    FontWeight="SemiBold" />
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Content="アイテム追加"
                        Command="{x:Bind ViewModel.AddItemRowCommand}"
                        Padding="8,4"
                        CornerRadius="4" />
                    <Button
                        Content="選択削除"
                        Command="{x:Bind ViewModel.DeleteSelectedItemRowCommand}"
                        Padding="8,4"
                        CornerRadius="4" />
                </StackPanel>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Content="選択を上へ"
                        Command="{x:Bind ViewModel.MoveItemRowUpCommand}"
                        Padding="8,4"
                        CornerRadius="4" />
                    <Button
                        Content="選択を下へ"
                        Command="{x:Bind ViewModel.MoveItemRowDownCommand}"
                        Padding="8,4"
                        CornerRadius="4" />
                </StackPanel>

                <!-- 一覧全体操作 -->
                <TextBlock
                    Text="一覧全体"
                    Margin="0,8,0,0"
                    FontSize="12"
                    FontWeight="SemiBold" />
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Content="一覧ソート"
                        Command="{x:Bind ViewModel.SortItemsCommand}"
                        Padding="8,4"
                        CornerRadius="4" />
                    <Button
                        Content="一覧シャッフル"
                        Command="{x:Bind ViewModel.ShuffleItemsCommand}"
                        Padding="8,4"
                        CornerRadius="4" />
                </StackPanel>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Content="CSVエクスポート"
                        Click="OnExportCsvButtonClick"
                        Padding="8,4"
                        CornerRadius="4" />
                    <Button
                        Content="CSVインポート"
                        Click="OnImportCsvButtonClick"
                        Padding="8,4"
                        CornerRadius="4" />
                </StackPanel>

                <!-- ウィンドウ操作 -->
                <TextBlock
                    Text="ウィンドウ操作"
                    Margin="0,8,0,0"
                    FontSize="12"
                    FontWeight="SemiBold" />
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Content="ウィンドウサイズをリセット"
                        Click="OnResetWindowSizeButtonClick"
                        Padding="8,4"
                        CornerRadius="4" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
