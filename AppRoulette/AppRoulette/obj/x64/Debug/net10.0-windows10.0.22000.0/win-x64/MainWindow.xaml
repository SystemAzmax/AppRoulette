<?xml version="1.0" encoding="utf-8"?>
<Window x:ConnectionId='1'
    x:Class="AppRoulette.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AppRoulette"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AppRoulette">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

        <!--
        ルート Grid: 左列（ルーレット）/ 中央列（リスト項目タブ）/ 右列（操作パネル）
    -->
    <Grid x:ConnectionId='2' Margin="16"                                                                    >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- ===== 左列：ルーレット描画エリア ===== -->
        <Grid Grid.Column="0">

            <!-- Win2D CanvasControl（扇形描画・インジケーター含む） -->
            <canvas:CanvasControl x:ConnectionId='44'
                x:Name="RouletteCanvas"
                                          
                                              
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />

        </Grid>

        <!-- ===== 中央列：リスト項目タブ（詳細 / テキスト） ===== -->
        <Grid
            Grid.Column="2"
            Margin="4,4,4,0"
            VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--
                TabView 標準のタブ下線は実際のタブ幅分しか描画されず、
                右側の空きエリアで線が途切れて見えるため、
                タブ行全体に明示的な Border（下線）を敷いて解消する。
            -->
            <Border
                Grid.Row="0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <Button x:ConnectionId='42'
                            x:Name="DetailTabButton"
                            Content="詳細"
                                                          
                            Padding="16,8"
                            CornerRadius="0"
                            Background="Transparent"
                            BorderThickness="0" />
                        <Button x:ConnectionId='43'
                            x:Name="TextTabButton"
                            Content="テキスト"
                                                        
                            Padding="16,8"
                            CornerRadius="0"
                            Background="Transparent"
                            BorderThickness="0" />
                    </StackPanel>

                    <TextBlock x:ConnectionId='41'
                        Grid.Column="2"
                                                                                  
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Margin="0,0,8,0" />
                </Grid>
            </Border>

            <!-- 詳細タブの内容 -->
            <Grid x:ConnectionId='32'
                x:Name="DetailTabPanel"
                Grid.Row="1"
                Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- アイテム詳細表 -->
                <Border
                    Grid.Row="0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid
                            Grid.Row="0"
                            Padding="8,6"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="有効" FontWeight="SemiBold"
                                       ToolTipService.ToolTip="チェックを外すと抽選対象から一時的に除外されます。" />
                            <TextBlock Grid.Column="1" Text="名前" FontWeight="SemiBold" />
                            <TextBlock
                                Grid.Column="3"
                                Text="Weight"
                                FontWeight="SemiBold"
                                ToolTipService.ToolTip="Weight は 1～5 の範囲で指定します。値が大きいほど選ばれやすくなります。" />
                        </Grid>

                        <ListView x:ConnectionId='37'
                            x:Name="ItemsListView"
                            Grid.Row="1"
                                                                                       
                                                                                               
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox
                                            IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                            IsEnabled="{Binding CanUnchecked, Mode=OneWay}"
                                            MinWidth="0"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="チェックを外すと抽選対象から一時的に除外されます。" />
                                        <TextBox x:ConnectionId='39'
                                            Grid.Column="1"
                                            Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                   
                                            PlaceholderText="名前" />
                                        <NumberBox x:ConnectionId='40'
                                            Grid.Column="3"
                                            Value="{Binding Weight, Mode=TwoWay}"
                                            Minimum="1"
                                            Maximum="5"
                                            MinWidth="112"
                                            SmallChange="1"
                                            SpinButtonPlacementMode="Compact"
                                                                                      
                                            ToolTipService.ToolTip="Weight は 1～5 の範囲で指定します。値が大きいほど選ばれやすくなります。" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <TextBlock x:ConnectionId='36'
                    Grid.Row="1"
                                                                             
                    Margin="0,6,0,0"
                    FontSize="12"
                    Foreground="DarkOrange"
                    TextWrapping="Wrap" />
            </Grid>

            <!-- テキストタブの内容 -->
            <Grid x:ConnectionId='33'
                x:Name="TextTabPanel"
                Grid.Row="1"
                Margin="0,8,0,0"
                Visibility="Collapsed">
                <TextBox x:ConnectionId='35'
                    x:Name="ItemsTextBox"
                                                           
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    FontFamily="Consolas"
                    PlaceholderText="テキスト貼り付けも可能です（名前,Weight / 最大30件）" />
            </Grid>

            <!-- スタートボタン：タブ切替に関わらず常に表示 -->
            <Button x:ConnectionId='34'
                Grid.Row="2"
                Content="スタート"
                                                                      
                                          
                Margin="0,12,0,0"
                Padding="0,10"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                FontWeight="SemiBold"
                CornerRadius="6"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>


        <!-- ===== 右列：操作パネル ===== -->
        <ScrollViewer
            Grid.Column="4"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">

                <!-- グループ ComboBox + リスト位置 + アイテム数 + クリア -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">

                    <ComboBox x:ConnectionId='29'
                        x:Name="GroupComboBox"
                                                                               
                                                                                    
                        DisplayMemberPath="DisplayName"
                                                                         
                        MinWidth="120" />

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="2"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="リスト"
                            VerticalAlignment="Center" />
                        <TextBlock x:ConnectionId='31'
                                                                                            
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <Button x:ConnectionId='30'
                        Content="クリア"
                                                                      
                        Padding="8,4"
                        CornerRadius="4" />
                </StackPanel>

                <TextBlock x:ConnectionId='3'
                                                                         
                    TextWrapping="NoWrap"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Opacity="0.72" />

                <!-- 当たったら除外モード（グループごと） -->
                <CheckBox x:ConnectionId='4'
                    Content="当たったら除外"
                                                                                     
                    ToolTipService.ToolTip="ONにすると、当選した項目が次回以降の抽選から自動的に除外されます。" />

                <!-- グループ名編集 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:ConnectionId='25'
                        x:Name="GroupNameUnsavedBorder"
                        Grid.Column="0"
                        BorderBrush="Transparent"
                        BorderThickness="2"
                        CornerRadius="6"
                        Padding="2">
                        <TextBox x:ConnectionId='28'
                                                                                                                     
                            PlaceholderText="グループ名" />
                    </Border>
                    <Button x:ConnectionId='26'
                        Grid.Column="2"
                        Content="変更"
                                                                       
                        Padding="8,4"
                        CornerRadius="4"
                        MinWidth="72"
                        HorizontalContentAlignment="Center" />
                    <Button x:ConnectionId='27'
                        Grid.Column="4"
                        Content="リセット"
                                                                          
                        Padding="8,4"
                        CornerRadius="4"
                        MinWidth="72"
                        HorizontalContentAlignment="Center" />
                </Grid>

                <TextBlock x:ConnectionId='5'
                    x:Name="GroupNameUnsavedText"
                    Text="未保存"
                    FontSize="12"
                    Foreground="DarkOrange"
                    Opacity="0" />

                <!-- グループ操作 -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button x:ConnectionId='23'
                        Content="リストを追加"
                                                                    
                        Padding="8,4"
                        CornerRadius="4"
                        MinWidth="140"
                        HorizontalContentAlignment="Center" />
                    <Button x:ConnectionId='24'
                        Content="リストを削除"
                                                                       
                        Padding="8,4"
                        CornerRadius="4"
                        MinWidth="140"
                        HorizontalContentAlignment="Center" />
                </StackPanel>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button x:ConnectionId='22'
                        Content="リストを複製"
                                                                          
                        Padding="8,4"
                        CornerRadius="4"
                        MinWidth="140"
                        HorizontalContentAlignment="Center" />
                </StackPanel>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button x:ConnectionId='20'
                        Content="リストを上へ"
                                                                       
                        Padding="8,4"
                        CornerRadius="4"
                        MinWidth="140"
                        HorizontalContentAlignment="Center" />
                    <Button x:ConnectionId='21'
                        Content="リストを下へ"
                                                                         
                        Padding="8,4"
                        CornerRadius="4"
                        MinWidth="140"
                        HorizontalContentAlignment="Center" />
                </StackPanel>

                <!-- 選択アイテム操作 -->
                <TextBlock
                    Text="選択アイテム操作"
                    Margin="0,8,0,0"
                    FontSize="12"
                    FontWeight="SemiBold" />
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button x:ConnectionId='18'
                        Content="アイテム追加"
                                                                      
                        Padding="8,4"
                        CornerRadius="4"
                        MinWidth="108"
                        HorizontalContentAlignment="Center" />
                    <Button x:ConnectionId='19'
                        Content="選択削除"
                                                                                 
                        Padding="8,4"
                        CornerRadius="4"
                        MinWidth="108"
                        HorizontalContentAlignment="Center" />
                </StackPanel>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button x:ConnectionId='16'
                        Content="選択を上へ"
                                                                         
                        Padding="8,4"
                        CornerRadius="4"
                        MinWidth="108"
                        HorizontalContentAlignment="Center" />
                    <Button x:ConnectionId='17'
                        Content="選択を下へ"
                                                                           
                        Padding="8,4"
                        CornerRadius="4"
                        MinWidth="108"
                        HorizontalContentAlignment="Center" />
                </StackPanel>

                <!-- 一覧全体操作 -->
                <TextBlock
                    Text="一覧全体"
                    Margin="0,8,0,0"
                    FontSize="12"
                    FontWeight="SemiBold" />
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button x:ConnectionId='14'
                        Content="一覧ソート"
                                                                     
                        Padding="8,4"
                        CornerRadius="4"
                        MinWidth="132"
                        HorizontalContentAlignment="Center" />
                    <Button x:ConnectionId='15'
                        Content="一覧シャッフル"
                                                                        
                        Padding="8,4"
                        CornerRadius="4"
                        MinWidth="132"
                        HorizontalContentAlignment="Center" />
                </StackPanel>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button x:ConnectionId='12'
                        Content="CSVエクスポート"
                                                      
                        Padding="8,4"
                        CornerRadius="4"
                        MinWidth="132"
                        HorizontalContentAlignment="Center" />
                    <Button x:ConnectionId='13'
                        Content="CSVインポート"
                                                      
                        Padding="8,4"
                        CornerRadius="4"
                        MinWidth="132"
                        HorizontalContentAlignment="Center" />
                </StackPanel>

                <!-- OneDrive 同期 -->
                <TextBlock x:ConnectionId='6'
                    Text="OneDrive 同期"
                    Margin="0,8,0,0"
                    FontSize="12"
                    FontWeight="SemiBold"
                                                                    />
                <StackPanel x:ConnectionId='7'
                    Orientation="Vertical"
                    Spacing="8"
                                                                   >
                    <Button x:ConnectionId='10'
                        Content="今すぐ同期"
                                                                   
                        Padding="8,4"
                        CornerRadius="4"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
                    <TextBlock x:ConnectionId='11'
                                                                             
                        FontSize="11" />
                </StackPanel>

                <!-- ウィンドウ操作 -->
                <TextBlock
                    Text="ウィンドウ操作"
                    Margin="0,8,0,0"
                    FontSize="12"
                    FontWeight="SemiBold" />
                <StackPanel
                    Orientation="Vertical"
                    Spacing="8">
                    <Button x:ConnectionId='8'
                        Content="ウィンドウサイズをリセット"
                                                            
                        Padding="8,4"
                        CornerRadius="4"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
                    <ToggleButton x:ConnectionId='9'
                        x:Name="AlwaysOnTopToggleButton"
                        Content="常に最前面表示"
                                                              
                        Padding="8,4"
                        CornerRadius="4"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

